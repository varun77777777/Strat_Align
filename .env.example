# ============================================================
#  Strat-Align Multi-Service Deployment — env template
# ============================================================

# ─── Express Backend Service (Port 5000) ─────────────────────
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/strat_align
FRONTEND_URL=http://localhost:5173

# ─── FastAPI AI Microservice (Port 8000) ────────────────────
AI_PORT=8000
GEMINI_API_KEY=your_gemini_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_token_here
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000,http://localhost:5173

# ─── React Frontend App (Vite) ──────────────────────────────
VITE_API_BASE_URL=http://localhost:5000/api
