# ============================================================
#  Strat-Align Backend — Environment Variables
#  Copy this file to .env and fill in your values
# ============================================================

# ─── Server ─────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ────────────────────────────────────────────────
# Local:   mongodb://localhost:27017/strat_align
# Atlas:   mongodb+srv://<user>:<pass>@cluster.mongodb.net/strat_align
MONGODB_URI=mongodb://localhost:27017/strat_align

# ─── Google Gemini AI ────────────────────────────────────────
# Get your key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ─── Python AI Service ──────────────────────────────────────
# Local Python prediction microservice
AI_SERVICE_URL=http://localhost:8000/predict
AI_SERVICE_TIMEOUT=5000

# ─── Frontend (CORS) ────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Cache TTLs (seconds) ───────────────────────────────────
CACHE_TTL_TEAMS=10
CACHE_TTL_PREDICTIONS=30

# ─── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
